# Sources de collecte par pays
BENIN_SOURCE_URL=https://armp.bj
TOGO_SOURCE_URL=https://armp.tg
CI_SOURCE_URL=https://www.anrmp.ci

# API interne du backend (base). Les robots postent sur {BACKEND_API_URL}/ingest/tenders
BACKEND_API_URL=http://app:8080/api
# Jeton partagé — doit être identique à SCRAPERS_API_TOKEN du backend
SCRAPERS_API_TOKEN=am_scraper_7Kd93xQp2LmZ8vT

# Paramètres de collecte
SCRAPE_INTERVAL_MINUTES=120
USER_AGENT=AlerteMarcheBot/1.0 (+https://alertemarche.com)
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Journalisation
LOG_LEVEL=INFO
