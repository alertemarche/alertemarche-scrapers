# Sources de collecte par pays
BENIN_SOURCE_URL=https://armp.bj
TOGO_SOURCE_URL=https://armp.tg
CI_SOURCE_URL=https://www.anrmp.ci

# Base de données (partagée avec le backend)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=alertemarche
DB_USERNAME=alertemarche
DB_PASSWORD=change_me

# API interne du backend (réception des opportunités collectées)
BACKEND_API_URL=http://backend:8080/api/internal/opportunities
BACKEND_API_TOKEN=

# Paramètres de collecte
SCRAPE_INTERVAL_MINUTES=60
USER_AGENT=AlerteMarcheBot/1.0 (+https://alertemarche.com)
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Journalisation
LOG_LEVEL=INFO
